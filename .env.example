# SOURCE OF TRUTH KEYWORDS: env example, DATABASE_URL, GOOGLE_AI_STUDIO_API, GEMINI_CHAT_MODEL, RESEND_API_KEY
# WHAT: Placeholder environment variables for local and Vercel production setup.
# WHY: Documents required secrets without committing real values (.env is gitignored).
# WHERE: Copied to `.env` locally; the same keys are set on the Vercel project.

# Database (Prisma 7 — required at generate and runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"
BETTER_AUTH_URL="https://your-production-domain.example"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
ALLOWED_ADMINS="you@example.com"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="Mindscape Analytics <noreply@mindscapeanalytics.com>"
NOTIFICATION_EMAILS="info@mindscapeanalytics.com,zeeshan.keerio@mindscapeanalytics.com"

# Optional integrations
DISCORD_WEBHOOK_URL=""
NVIDIA_NIM_API_KEY=""
OPENROUTER_API_KEY=""
CA_CERT=""

# Website assistant. All keys stay server-side. Gemini is the default; OpenAI is an optional fallback.
GOOGLE_AI_STUDIO_API=""
GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-6-luna"
