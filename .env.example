# SOURCE OF TRUTH KEYWORDS: env example, DATABASE_URL, BETTER_AUTH_SECRET, STRIPE_SECRET_KEY, RESEND_API_KEY
# WHAT: Placeholder environment variables for local and Vercel production setup.
# WHY: Documents required secrets without committing real values (.env is gitignored).
# WHERE: Copied to `.env` locally; the same keys are set on the Vercel project.

# Database (Prisma 7 — required at generate and runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"
BETTER_AUTH_URL="https://your-production-domain.example"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
ALLOWED_ADMINS="you@example.com"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="Mindscape Analytics <noreply@mindscapeanalytics.com>"

# Optional integrations
DISCORD_WEBHOOK_URL=""
NVIDIA_NIM_API_KEY=""
GOOGLE_AI_STUDIO_API=""
OPENROUTER_API_KEY=""
CA_CERT=""
