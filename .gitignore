# SOURCE OF TRUTH KEYWORDS: gitignore, secrets, node_modules, .next, .env, generated prisma, vercel
# WHAT: Git exclusion list for the production Mindscape Analytics repository.
# WHY: Prevents secrets, build artifacts, local agent tooling, and generated clients from reaching GitHub.
# WHERE: Read by git at the repository root on add/commit/status.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — keep a committed placeholder only
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (rebuilt by postinstall / prisma generate)
/generated/prisma
/src/generated/prisma

# archive and local scratch
_archive/
scratch/

# editor / agent tooling (not part of the production app)
.idea/
.agents/
.codex/
.cursor/
.impeccable/
skills-lock.json

# local probe / one-off detector output (not production)
check-users.ts
detect-*.json
scripts/test-db.ts
scripts/verify-signup.js
